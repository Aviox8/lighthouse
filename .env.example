# Lighthouse works without any keys and uses a deterministic local summary.
# All variables below are optional.

# OpenRouter (primary AI summary provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000

# Ollama Cloud or a local Ollama server (first fallback)
# Set OLLAMA_API_KEY for Ollama Cloud; otherwise set OLLAMA_BASE_URL.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Exa (optional grounding for LLM summaries, and final AI fallback)
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=4
EXA_ANSWER_MODEL=exa

# Dedicated Overpass + geocoding instance (overpass.ch), optional but recommended.
# When set, it is used before the public Overpass mirrors and public Nominatim,
# which are frequently overloaded (HTTP 502 / timeouts). Server-side only: do not
# prefix with NEXT_PUBLIC_, or the key would be shipped to the browser.
OVERPASS_CH_KEY=

# Summary limits and caching
SUMMARY_RATE_LIMIT_PER_MINUTE=6
SUMMARY_DAILY_LIMIT=40
SUMMARY_PROVIDER_TIMEOUT_MS=12000
SUMMARY_CACHE_TTL_MS=21600000
